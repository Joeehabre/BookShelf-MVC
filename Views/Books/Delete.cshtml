@model BookShelf_MVC.Models.Book
@{
    ViewData["Title"] = "Delete Book";
}

<h1 class="h3 mb-4 text-danger">Delete Book</h1>

<div class="alert alert-warning">Are you sure you want to delete this book? This cannot be undone.</div>

<div class="card shadow-sm mb-3" style="max-width: 540px;">
    <div class="card-body">
        <h2 class="h5 mb-1">@Model.Title</h2>
        <p class="text-muted mb-0">by @Model.Author — @Model.Pages.ToString("N0") pages</p>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
